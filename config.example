# OpenHyprWhisper configuration
# Copy to ~/.config/openhyprwhisper/config and edit.
# This file is sourced by bash - keep it simple: KEY="value"

# Model: name of ggml-<name>.bin in ~/.local/share/openhyprwhisper/models,
# or an absolute path to a .bin file.
# Good options: large-v3-turbo-q5_0 (default, best), small, base.en (fastest)
#MODEL="large-v3-turbo-q5_0"

# Language code ("en", "ru", "de", "kk", ...) or "auto" to detect per utterance.
#LANGUAGE="auto"

# Translate speech to English instead of transcribing it.
#TRANSLATE="false"

# How to put text into the focused window:
#   type      - wtype/ydotool types it (works in most apps)
#   paste     - copy + Ctrl+V + restore clipboard (for apps that dislike wtype)
#   clipboard - just copy, you paste manually
#INJECT="type"

# Append a space after the transcribed text (nice for dictating in bursts).
#APPEND_SPACE="true"

# Keep whisper-server running with the model warm (near-instant results).
# Start it with: systemctl --user enable --now openhyprwhisper
#DAEMON="true"
#PORT="8595"

# Port of the local polish backend (llama-server); `ohw disable` stops it too.
#POLISH_PORT="8596"

# Pipewire source node, empty = default microphone (see: wpctl status)
#AUDIO_SOURCE=""

# Show the recording pill overlay (needs quickshell)
#OVERLAY="true"

# Where the pill appears:
#   bottom / top - fixed at the screen edge (respects your bar)
#   window       - attached to the focused window's bottom edge, so it follows
#                  where you're dictating (inspired by OpenSuperWhisper's
#                  caret-anchored card)
#OVERLAY_POSITION="bottom"

# Keep a history of transcriptions (view with: ohw history [n])
#HISTORY="true"

# Safety limit: auto-stop after this many seconds of recording
#MAX_RECORD_SECONDS="120"

# Bias transcription toward your vocabulary (names, jargon)
#INITIAL_PROMPT=""

# LLM polish: after transcription, fix grammar, punctuation and proper nouns
# (companies, games, famous people). Adds a few seconds per dictation.
# Default backend is scripts/polish-claude.sh (Claude Code CLI, no API key);
# set POSTPROCESS_CMD to any stdin->stdout command to use something else,
# e.g. a local ollama model.
#POSTPROCESS="false"
#POSTPROCESS_CMD=""
#POSTPROCESS_TIMEOUT="25"

# Polish mode:
#   full  - fix grammar, punctuation, capitalization and names (emails, documents)
#   light - ONLY fix names/brands; your wording, punctuation and casing stay
#           untouched (chat, terminal, AI prompts - the text still feels like yours)
#POSTPROCESS_MODE="full"

# Silence gate: if the loudest 100ms of the recording is below this RMS,
# skip transcription entirely (prevents "Thank you." hallucinations).
# Raise it if silence still gets through, lower it if quiet speech is dropped, 0 disables.
#SILENCE_PEAK="300"
